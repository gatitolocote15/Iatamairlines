SetEnv PHP_VER 5_3
SetEnv REGISTER_GLOBALS 0

RewriteEngine on

# Exclude _sapolio from all rewrites
RewriteCond %{REQUEST_URI} ^/_sapolio [NC]
RewriteRule ^ - [L]

# Comment out HTTPS redirect (no SSL)
# RewriteCond %{HTTPS} off
# RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# RewriteCond %{Request_URI} !/(style|forum)
# RewriteRule ^(.*)/(.*)$ $1_$2 [L]

<FilesMatch "\.(eot|woff|woff2|ttf|svg|otf|css)$">
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>
